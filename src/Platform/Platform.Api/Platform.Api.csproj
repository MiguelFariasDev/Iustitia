<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Advocacia.Platform.Api</RootNamespace>
    <!-- Biblioteca de endpoints/middlewares de Platform, consumida por Hosts/Api. Não é um host executável. -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Swashbuckle.AspNetCore (não Microsoft.AspNetCore.OpenApi) é o gerador de OpenAPI/Swagger
         UI deste projeto — ver ServiceCollectionExtensions.AddPlatformApi. Referenciar os dois
         pacotes ao mesmo tempo quebra a compilação: Microsoft.AspNetCore.OpenApi traz
         Microsoft.OpenApi 2.x (que removeu o namespace Microsoft.OpenApi.Models), e o CPM resolve
         a versão mais alta do pacote transitivo no grafo inteiro, inclusive para o Swashbuckle. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Asp.Versioning.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Application\Platform.Application.csproj" />
    <ProjectReference Include="..\Platform.Infrastructure\Platform.Infrastructure.csproj" />
  </ItemGroup>

</Project>
