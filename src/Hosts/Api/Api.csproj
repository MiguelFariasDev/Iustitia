<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Advocacia.Hosts.Api</RootNamespace>
    <UserSecretsId>advocacia-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenAPI/Swagger é gerado via Swashbuckle.AspNetCore (referenciado por Platform.Api) —
         não referenciar Microsoft.AspNetCore.OpenApi aqui: ver comentário em Platform.Api.csproj. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\Platform.Api\Platform.Api.csproj" />
    <ProjectReference Include="..\..\Platform\Platform.Infrastructure\Platform.Infrastructure.csproj" />
  </ItemGroup>

</Project>
