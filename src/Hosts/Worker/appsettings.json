{
  "AppName": "Iustitia",
  "AppEnv": "Development",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=advocacia_db;Username=postgres;Password=postgres"
  },
  "Supabase": {
    "Url": "",
    "AnonKey": "",
    "ServiceRoleKey": ""
  },
  "Drafting": {
    "Enabled": false,
    "Fila": {
      "IntervaloSegundos": 15,
      "LoteMax": 5,
      "Paralelismo": 1,
      "ParalelismoCpu": 2,
      "MaxTentativas": 3,
      "ReservaMinutos": 20,
      "BackoffBaseSegundos": 30,
      "ExpiraAposMinutos": 180
    },
    "Custo": {
      "GpuUsdPorHora": 0.40
    },
    "Anexos": {
      "MaxMegabytes": 30,
      "MaxMegabytesAudio": 100,
      "MaxPaginas": 500,
      "MaxPaginasOcr": 150,
      "MaxDocumentosPorCaso": 200,
      "MaxLinhasPlanilha": 2000
    },
    "Conversao": {
      "LibreOffice": "soffice",
      "Pdftoppm": "pdftoppm",
      "TimeoutSegundos": 120
    },
    "Ocr": {
      "Executavel": "tesseract",
      "Idioma": "por",
      "Dpi": 300,
      "TimeoutSegundos": 120,
      "Paralelismo": 2
    },
    "Transcricao": {
      "BaseUrl": "",
      "Caminho": "v1/audio/transcriptions",
      "Modelo": "whisper-large-v3",
      "Idioma": "pt",
      "TimeoutSegundos": 900
    }
  },
  "Rag": {
    "MaxTokensContexto": 8000,
    "CharsPorToken": 3.2,
    "Chunking": { "MinTokens": 400, "AlvoTokens": 700, "MaxTokens": 900, "IncluirEmentaEmTodos": true },
    "Busca": {
      "CandidatosVetor": 30,
      "CandidatosBm25": 30,
      "CandidatosRerank": 100,
      "Fusao": "Rrf",
      "RrfK": 60,
      "PesoReferencia": 2.0,
      "MaxPorNorma": 3,
      "ResultadosMin": 5,
      "ResultadosMax": 10,
      "VagasCaso": 4,
      "VagasConstituicao": 2,
      "VagasLeis": 4,
      "VagasJurisprudencia": 3,
      "RelevanciaMinimaReserva": 0.80,
      "IncluirRevogadas": true
    }
  },
  "Ingestao": {
    "Modo": "Local",
    "SomenteAltaUtilizacao": true,
    "DiretorioLocal": "/var/lib/advocacia/leis",
    "PastasIncluidas": [ "constituicao.md", "federal", "jurisprudencia" ],
    "PastasExcluidas": [ "_fonte", ".git", "scripts", "estaduais", "municipais", "reguladores", "tratados" ],
    "RepositorioUrl": "https://github.com/ctresb/leis.git",
    "Branch": "main",
    "ProfundidadeGit": 1,
    "BaixarOriginais": false,
    "WorkerHabilitado": false,
    "IntervaloHoras": 24,
    "LimiteArquivosPorCiclo": 5000,
    "LoteEmbedding": 32,
    "ParalelismoArquivos": 2,
    "Filtros": { "Ufs": [], "Municipios": [], "Tipos": [], "Areas": [], "AnoDe": null, "AnoAte": null },
    "Storage": {
      "Provedor": "Local",
      "Bucket": "juridico",
      "Prefixo": "juridico",
      "Endpoint": "https://CONTA.r2.cloudflarestorage.com",
      "Regiao": "auto",
      "DiretorioLocal": "/var/lib/advocacia/storage"
    }
  },
  "VastAi": {
    "ApiBaseUrl": "https://console.vast.ai/api/v0",
    "ApiKey": "",
    "InstanceId": "",
    "PollingIntervalSeconds": 10,
    "StartTimeoutMinutes": 10,
    "IdleTimeoutMinutes": 10,
    "MaxRetries": 3,
    "ResolverEndpointPelaVast": false
  },
  "Ollama": {
    "BaseUrl": "https://IA_HOST_COM_TLS:PORTA",
    "ApiKey": "",
    "Modelo": "jurema-7b",
    "ModeloEmbedding": "bge-m3",
    "TimeoutSegundos": 600,
    "Temperatura": 0.2,
    "TopP": 0.9,
    "NumCtx": 8192,
    "NumPredict": 2560,
    "KeepAlive": "10m",
    "AllowInsecureHttp": false
  },
  "Qdrant": {
    "BaseUrl": "https://QDRANT_HOST_COM_TLS:PORTA",
    "ApiKey": "",
    "AllowInsecureHttp": false
  },
  "Messaging": {
    "Transport": "RabbitMq",
    "AzureServiceBusConnectionString": "",
    "RabbitMq": {
      "Host": "localhost",
      "Port": 5673,
      "VirtualHost": "/",
      "Username": "guest",
      "Password": "guest"
    }
  },
  "Email": {
    "ApiBaseUrl": "https://api.resend.com/",
    "FromAddress": "",
    "FromName": "Iustitia",
    "AppBaseUrl": "",
    "AlertTypes": [ "Publication", "Task" ]
  },
  "Outbox": {
    "BatchSize": 100,
    "ProcessingIntervalSeconds": 10,
    "MaxRetries": 5,
    "RetentionDays": 30,
    "BackoffBaseSeconds": 2
  },
  "Hangfire": {
    "DashboardEnabled": false,
    "DashboardPath": "/jobs",
    "WorkerCount": 4,
    "ProcessJobs": true
  },
  "Jobs": {
    "AcompanhamentoMovimentacoes": {
      "_comment": "Acompanhamento noturno de andamentos pelo juscraper (DataJud só para tribunal sem cobertura) — ADR-075. DESLIGADO por padrão. Alerta o responsável e cria rascunhos de aviso ao cliente; NUNCA envia ao cliente sem revisão.",
      "Enabled": false,
      "CronExpression": "30 2 * * *",
      "JanelaDias": 3,
      "PausaEntreProcessosMs": 1500,
      "TenantIds": []
    },
    "CalendarReminder": {
      "Enabled": true,
      "CronExpression": "*/5 * * * *"
    },
    "OutboxProcessor": {
      "Enabled": true,
      "CronExpression": "* * * * *"
    },
    "OutboxCleanup": {
      "Enabled": true,
      "CronExpression": "0 3 * * *"
    },
    "AuditLogCleanup": {
      "Enabled": true,
      "CronExpression": "0 4 * * 0"
    },
    "HealthCheck": {
      "Enabled": true,
      "CronExpression": "*/5 * * * *"
    },
    "CnjCapture": {
      "Enabled": true,
      "CronExpression": "0 */6 * * *",
      "LookbackDays": 3,
      "_comment_Tribunais": "VAZIO de propósito. A varredura por tribunal traz o diário inteiro — publicações de processos de TERCEIROS, que não são do escritório. A captura é dirigida pelos processos cadastrados. Só preencher para diagnosticar a integração, e esvaziar depois.",
      "Tribunais": [],
      "CnjNumbers": [],
      "RestrictProcessCaptureToWindow": false,
      "PageSize": 100,
      "MaxPages": 50,
      "BatchSize": 10,
      "DelayBetweenBatchesMs": 1000,
      "TenantIds": []
    },
    "PublicationClassification": {
      "Enabled": true,
      "CronExpression": "*/15 * * * *",
      "BatchSizePerTenant": 20,
      "MaxInvalidResponseAttempts": 3,
      "TenantIds": []
    }
  },
  "Anthropic": {
    "_comment": "Messages API da Anthropic (classificação de publicações e sugestão de prazo — ver ADR-067 e ADR-070). A ApiKey NUNCA vai neste arquivo: user-secrets em dev, Key Vault (Anthropic--ApiKey) em produção. Contrato de não-treinamento: docs/compliance/contrato-nao-treinamento-anthropic.md. Modelos: o claude-3-5-sonnet-20241022 foi aposentado pela Anthropic; usar o Sonnet atual e rodar os testes de regressão de prompt ao trocar. Pricing em USD por milhão de tokens — conferir na página de preços da Anthropic.",
    "BaseUrl": "https://api.anthropic.com/v1/",
    "ApiKey": "",
    "ApiVersion": "2023-06-01",
    "DefaultModel": "claude-sonnet-5-5",
    "DefaultMaxTokens": 4096,
    "Effort": "medium",
    "TimeoutSeconds": 60,
    "MaxRetries": 3,
    "RetryBaseDelaySeconds": 2,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerSamplingDurationSeconds": 120,
    "CircuitBreakerMinimumThroughput": 5,
    "CircuitBreakerBreakDurationSeconds": 60,
    "Models": {
      "Classification": "claude-sonnet-5-5",
      "Deadline": "claude-sonnet-5-5",
      "MaxOutputTokens": 4096,
      "MaxContentCharacters": 16000
    },
    "Pricing": {
      "claude-sonnet-5-5": {
        "InputPerMillion": 2.0,
        "OutputPerMillion": 10.0,
        "CacheWritePerMillion": 2.5,
        "CacheReadPerMillion": 0.2
      }
    }
  },
  "Cnj": {
    "BaseUrl": "https://comunicaapi.pje.jus.br/",
    "PublicationsPath": "api/v1/comunicacao",
    "MaxPageSize": 100,
    "TimeoutSeconds": 30,
    "RetryCount": 3,
    "RetryBaseDelaySeconds": 2,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerSamplingDurationSeconds": 60,
    "CircuitBreakerMinimumThroughput": 10,
    "CircuitBreakerBreakDurationSeconds": 60,
    "RateLimitPermitsPerWindow": 18,
    "RateLimitWindowSeconds": 5,
    "RateLimitQueueTimeoutSeconds": 120
  },
  "HealthChecks": {
    "Enabled": true,
    "OutboxPendingThresholdMinutes": 30,
    "DatabaseTimeoutSeconds": 5,
    "RedisTimeoutSeconds": 3,
    "ServiceBusTimeoutSeconds": 5
  },
  "OpenTelemetry": {
    "ServiceName": "Advocacia.Worker",
    "ServiceVersion": "0.1.0"
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "FeatureManagement": {
    "EnabledOnStartup": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "Hangfire": "Information",
        "MassTransit": "Information"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Juscraper": {
    "_comment": "Consulta direta aos portais dos tribunais (e-SAJ, PJe) — fonte principal da consulta de processo e do acompanhamento; DataJud é o fallback (ADR-075, docs/integrations/juscraper.md). BaseUrl vazio desliga o juscraper (só DataJud). A ApiKey NUNCA vai aqui: user-secrets em dev, Key Vault (Juscraper--ApiKey) em produção. FallbackDataJud deve ir para false se o produto for comercializado (Termo do DataJud, ADR-064).",
    "BaseUrl": "",
    "ConsultaTimeout": "00:01:00",
    "AcompanhamentoTimeout": "00:03:00",
    "FallbackDataJud": true,
    "FallbackQuandoNaoEncontrado": false
  },
  "DataJud": {
    "_comment": "API Pública do DataJud (CNJ) — metadados de processo. USO RESTRITO A PORTFÓLIO: o Termo de Uso proíbe uso comercial (cláusulas 3.3 e 3.8). Ver ADR-064 e docs/compliance/datajud-termo.md. A ApiKey é pública mas fica fora daqui: user-secrets em dev, Key Vault em produção.",
    "BaseUrl": "https://api-publica.datajud.cnj.jus.br",
    "ApiKey": "",
    "TimeoutSeconds": 10,
    "RetryCount": 1,
    "RateLimitPauseSeconds": 120,
    "RetryBaseDelaySeconds": 2,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerSamplingDurationSeconds": 30,
    "CircuitBreakerMinimumThroughput": 5,
    "CircuitBreakerBreakDurationSeconds": 60,
    "CacheTtlMinutes": 60
  }
}
