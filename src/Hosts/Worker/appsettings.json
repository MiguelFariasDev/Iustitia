{
  "AppName": "Iustitia",
  "AppEnv": "Development",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=advocacia_db;Username=postgres;Password=postgres"
  },
  "Supabase": {
    "Url": "",
    "AnonKey": "",
    "ServiceRoleKey": ""
  },
  "Messaging": {
    "Transport": "RabbitMq",
    "AzureServiceBusConnectionString": "",
    "RabbitMq": {
      "Host": "localhost",
      "Port": 5673,
      "VirtualHost": "/",
      "Username": "guest",
      "Password": "guest"
    }
  },
  "Outbox": {
    "BatchSize": 100,
    "ProcessingIntervalSeconds": 10,
    "MaxRetries": 5,
    "RetentionDays": 30,
    "BackoffBaseSeconds": 2
  },
  "Hangfire": {
    "DashboardEnabled": false,
    "DashboardPath": "/jobs",
    "WorkerCount": 4,
    "ProcessJobs": true
  },
  "Jobs": {
    "CalendarReminder": {
      "Enabled": true,
      "CronExpression": "*/5 * * * *"
    },
    "OutboxProcessor": {
      "Enabled": true,
      "CronExpression": "* * * * *"
    },
    "OutboxCleanup": {
      "Enabled": true,
      "CronExpression": "0 3 * * *"
    },
    "AuditLogCleanup": {
      "Enabled": true,
      "CronExpression": "0 4 * * 0"
    },
    "HealthCheck": {
      "Enabled": true,
      "CronExpression": "*/5 * * * *"
    },
    "CnjCapture": {
      "Enabled": true,
      "CronExpression": "0 */6 * * *",
      "LookbackDays": 3,
      "_comment_Tribunais": "VAZIO de propósito. A varredura por tribunal traz o diário inteiro — publicações de processos de TERCEIROS, que não são do escritório. A captura é dirigida pelos processos cadastrados. Só preencher para diagnosticar a integração, e esvaziar depois.",
      "Tribunais": [],
      "CnjNumbers": [],
      "RestrictProcessCaptureToWindow": false,
      "PageSize": 100,
      "MaxPages": 50,
      "BatchSize": 10,
      "DelayBetweenBatchesMs": 1000,
      "TenantIds": []
    },
    "PublicationClassification": {
      "Enabled": true,
      "CronExpression": "*/15 * * * *",
      "BatchSizePerTenant": 20,
      "MaxInvalidResponseAttempts": 3,
      "TenantIds": []
    }
  },
  "Anthropic": {
    "_comment": "Messages API da Anthropic (classificação de publicações e sugestão de prazo — ver ADR-067 e ADR-070). A ApiKey NUNCA vai neste arquivo: user-secrets em dev, Key Vault (Anthropic--ApiKey) em produção. Contrato de não-treinamento: docs/compliance/contrato-nao-treinamento-anthropic.md. Modelos: o claude-3-5-sonnet-20241022 foi aposentado pela Anthropic; usar o Sonnet atual e rodar os testes de regressão de prompt ao trocar. Pricing em USD por milhão de tokens — conferir na página de preços da Anthropic.",
    "BaseUrl": "https://api.anthropic.com/v1/",
    "ApiKey": "",
    "ApiVersion": "2023-06-01",
    "DefaultModel": "claude-sonnet-5-5",
    "DefaultMaxTokens": 4096,
    "Effort": "medium",
    "TimeoutSeconds": 60,
    "MaxRetries": 3,
    "RetryBaseDelaySeconds": 2,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerSamplingDurationSeconds": 120,
    "CircuitBreakerMinimumThroughput": 5,
    "CircuitBreakerBreakDurationSeconds": 60,
    "Models": {
      "Classification": "claude-sonnet-5-5",
      "Deadline": "claude-sonnet-5-5",
      "MaxOutputTokens": 4096,
      "MaxContentCharacters": 16000
    },
    "Pricing": {
      "claude-sonnet-5-5": {
        "InputPerMillion": 2.0,
        "OutputPerMillion": 10.0,
        "CacheWritePerMillion": 2.5,
        "CacheReadPerMillion": 0.2
      }
    }
  },
  "Cnj": {
    "BaseUrl": "https://comunicaapi.pje.jus.br/",
    "PublicationsPath": "api/v1/comunicacao",
    "MaxPageSize": 100,
    "TimeoutSeconds": 30,
    "RetryCount": 3,
    "RetryBaseDelaySeconds": 2,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerSamplingDurationSeconds": 60,
    "CircuitBreakerMinimumThroughput": 10,
    "CircuitBreakerBreakDurationSeconds": 60,
    "RateLimitPermitsPerWindow": 18,
    "RateLimitWindowSeconds": 5,
    "RateLimitQueueTimeoutSeconds": 120
  },
  "HealthChecks": {
    "Enabled": true,
    "OutboxPendingThresholdMinutes": 30,
    "DatabaseTimeoutSeconds": 5,
    "RedisTimeoutSeconds": 3,
    "ServiceBusTimeoutSeconds": 5
  },
  "OpenTelemetry": {
    "ServiceName": "Advocacia.Worker",
    "ServiceVersion": "0.1.0"
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "FeatureManagement": {
    "EnabledOnStartup": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "Hangfire": "Information",
        "MassTransit": "Information"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "DataJud": {
    "_comment": "API Pública do DataJud (CNJ) — metadados de processo. USO RESTRITO A PORTFÓLIO: o Termo de Uso proíbe uso comercial (cláusulas 3.3 e 3.8). Ver ADR-064 e docs/compliance/datajud-termo.md. A ApiKey é pública mas fica fora daqui: user-secrets em dev, Key Vault em produção.",
    "BaseUrl": "https://api-publica.datajud.cnj.jus.br",
    "ApiKey": "",
    "TimeoutSeconds": 30,
    "RetryCount": 3,
    "RetryBaseDelaySeconds": 2,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerSamplingDurationSeconds": 30,
    "CircuitBreakerMinimumThroughput": 5,
    "CircuitBreakerBreakDurationSeconds": 60,
    "CacheTtlMinutes": 60
  }
}
