# Marca (Marca Desacoplada — ADR-023). Nunca hardcode o nome do produto.
NEXT_PUBLIC_APP_NAME=Iustitia

# API .NET (Hosts/Api)
NEXT_PUBLIC_API_URL=http://localhost:5093/api/v1

# Supabase (projeto dev). A anon key é pública por design; a service role key NUNCA vai no frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Modo de autenticação: "supabase" (padrão) ou "mock" (somente dev/E2E, sem Supabase).
NEXT_PUBLIC_AUTH_MODE=supabase

# Dados de negócio: "false" consome a API .NET de verdade, "true" usa mocks locais.
#
# A partir da Etapa 1.4 já existem endpoints reais para publicações, usuários, perfil,
# escritório e auditoria — com API_MOCKS=false essas telas puxam dados reais. Processos
# (Fase 2), prazos/alertas (Fase 3) e agenda (Fase 4) continuam vindo do mock mesmo com
# "false", porque não têm endpoint; ver features/dashboard/api.ts.
#
# As duas chaves são independentes de propósito: dá para rodar AUTH_MODE=mock com
# API_MOCKS=false (API real, sessão simulada) enquanto o Supabase não está configurado.
NEXT_PUBLIC_API_MOCKS=false
